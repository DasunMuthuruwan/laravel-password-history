{
    "name": "devdasun/password-history",
    "description": "Prevent users from reusing recent passwords in Laravel",
    "homepage": "https://github.com/DasunMuthuruwan/laravel-password-history",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Dasun Kalupahana",
            "email": "dasunmuthuruwan9@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/hashing": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "DevDasun\\PasswordHistory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DevDasun\\PasswordHistory\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DevDasun\\PasswordHistory\\PasswordHistoryServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
